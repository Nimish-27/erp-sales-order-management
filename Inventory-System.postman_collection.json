{
  "info": {
    "_postman_id": "2e042168-5cc1-40da-9762-0b0de67e3ca4",
    "name": "Fundsroom Inventory ERP API",
    "description": "Import this collection into Postman. Set the collection variables if needed, then run the requests in order for the customer → enquiry → quotation → order → reservation → dispatch workflow. Login requests use Postman's cookie jar for the HTTP-only JWT cookie. Admin-only routes require an Admin login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "adminEmail", "value": "admin@inventory.local" },
    { "key": "adminPassword", "value": "Password@123" },
    { "key": "salesEmail", "value": "sales@inventory.local" },
    { "key": "salesPassword", "value": "Password@123" },
    { "key": "customerId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "enquiryId", "value": "" },
    { "key": "quotationId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "dispatchId", "value": "" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Authentication",
      "description": "Login stores the HTTP-only JWT in Postman's cookie jar. Use Admin login for admin-only requests. Run logout when finished.",
      "item": [
        {
          "name": "Login — Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login — Sales",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{salesEmail}}\",\n  \"password\": \"{{salesPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Register user — Admin only",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"new.sales@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"role\": \"SALES\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Customers",
      "description": "Customer creation is available to Admin and Sales. Updates and deactivation are Admin only.",
      "item": [
        { "name": "List customers", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/customers?page=1&limit=20" } },
        {
          "name": "Create customer",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('customerId', json.data.id);"] } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"companyName\": \"Postman Demo Industries\",\n  \"contactPerson\": \"Asha Mehta\",\n  \"mobile\": \"+919876543210\",\n  \"email\": \"asha@example.com\",\n  \"city\": \"Mumbai\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "Update customer — Admin only",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"city\": \"Pune\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/customers/{{customerId}}" }
        },
        {
          "name": "Deactivate customer — Admin only (soft delete)",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/customers/{{customerId}}" }
        }
      ]
    },
    {
      "name": "Products",
      "description": "Products can be read by all roles. Product writes are Admin only.",
      "item": [
        { "name": "List products", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products?page=1&limit=20" } },
        { "name": "Get product", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products/{{productId}}" } },
        {
          "name": "Create product — Admin only",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('productId', json.data.id);"] } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productCode\": \"PM-{{$timestamp}}\",\n  \"name\": \"Postman Sample Item\",\n  \"category\": \"General\",\n  \"unit\": \"pcs\",\n  \"basePrice\": 100,\n  \"gstPercent\": 18,\n  \"physicalQty\": 100,\n  \"reorderLevel\": 10\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Update product — Admin only",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"basePrice\": 110\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/products/{{productId}}" }
        },
        { "name": "Deactivate product — Admin only (soft delete)", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/products/{{productId}}" } }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        { "name": "List inventory", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/inventory" } },
        { "name": "Get product inventory", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/inventory/{{productId}}" } },
        {
          "name": "Set damaged quantity — Admin only",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"damagedQty\": 0\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/inventory/{{productId}}/damaged" }
        }
      ]
    },
    {
      "name": "Enquiries",
      "item": [
        { "name": "List enquiries", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/enquiries?page=1&limit=20" } },
        { "name": "Get enquiry", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/enquiries/{{enquiryId}}" } },
        {
          "name": "Create enquiry",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('enquiryId', json.data.id);"] } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"requiredDate\": \"2030-12-31T00:00:00.000Z\",\n  \"notes\": \"Postman workflow example\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2 }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/enquiries"
          }
        },
        {
          "name": "Update enquiry",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"notes\": \"Updated from Postman\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/enquiries/{{enquiryId}}" }
        },
        {
          "name": "Change enquiry status (CLOSED or CANCELLED)",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"CANCELLED\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/enquiries/{{enquiryId}}/status" }
        },
        { "name": "Delete enquiry — Admin only (only if no quotations exist)", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/enquiries/{{enquiryId}}" } }
      ]
    },
    {
      "name": "Quotations",
      "item": [
        { "name": "List quotations", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/quotations?page=1&limit=20" } },
        { "name": "Get quotation", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/quotations/{{quotationId}}" } },
        {
          "name": "Create quotation",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('quotationId', json.data.id);"] } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"enquiryId\": \"{{enquiryId}}\",\n  \"validUntil\": \"2030-12-31T23:59:59.000Z\",\n  \"notes\": \"Postman quotation example\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2, \"unitPrice\": 100, \"discountPct\": 0, \"gstPct\": 18 }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/quotations"
          }
        },
        {
          "name": "Update draft quotation",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"notes\": \"Revised quotation note\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/quotations/{{quotationId}}" }
        },
        { "name": "Send quotation", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"SENT\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/quotations/{{quotationId}}/status" } },
        { "name": "Accept quotation", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACCEPTED\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/quotations/{{quotationId}}/status" } },
        { "name": "Reject quotation (alternative to Accept)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"REJECTED\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/quotations/{{quotationId}}/status" } },
        { "name": "Delete quotation — Admin only", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/quotations/{{quotationId}}" } }
      ]
    },
    {
      "name": "Sales orders",
      "item": [
        { "name": "List sales orders", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/orders?page=1&limit=20" } },
        { "name": "Get sales order", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/orders/{{orderId}}" } },
        {
          "name": "Convert accepted quotation to order",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('orderId', json.data.id);"] } }],
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/orders/quotations/{{quotationId}}/convert" }
        },
        { "name": "Confirm order and reserve stock — Admin only", "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/orders/{{orderId}}/confirm" } },
        { "name": "Confirm order — inventory route alias", "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/inventory/orders/{{orderId}}/confirm" } },
        { "name": "Cancel order — Admin only (alternative to dispatch)", "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/orders/{{orderId}}/cancel" } }
      ]
    },
    {
      "name": "Dispatches",
      "description": "Create only after confirming the order. Dispatch creation deducts physical and reserved inventory. Advance status in sequence: IN_TRANSIT, then DELIVERED.",
      "item": [
        {
          "name": "Create dispatch — Admin only",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('dispatchId', json.data.id);"] } }],
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"vehicleNumber\": \"MH-12-AB-1234\",\n  \"driverName\": \"Asha Mehta\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/dispatches/sales-orders/{{orderId}}/dispatch"
          }
        },
        { "name": "Mark dispatch in transit — Admin only", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_TRANSIT\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/dispatches/{{dispatchId}}/status" } },
        { "name": "Mark dispatch delivered — Admin only", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"DELIVERED\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/dispatches/{{dispatchId}}/status" } }
      ]
    }
  ]
}
