# IMPORTANT: Set to 'production' in prod — disables stack traces in error responses and SQL query logging
NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<dbname>"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="<generate_a_48_byte_random_string>"
JWT_EXPIRES_IN=1d

BCRYPT_ROUNDS=12

# CSRF: comma-separated list of allowed origins (required in production)
# Example: ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=

# Seed credentials (used by prisma/seed.js)
SEED_ADMIN_EMAIL="admin@inventory.local"
SEED_ADMIN_PASSWORD="<strong_password>"
SEED_SALES_EMAIL="sales@inventory.local"
SEED_SALES_PASSWORD="<strong_password>"
