generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  ADMIN
  SALES
  WAREHOUSE
  VIEWER
}

enum EnquiryStatus {
  OPEN
  QUOTED
  CLOSED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  CREATED
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum DispatchStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

// =====================================================
// USERS
// =====================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  reservations Reservation[]

  @@map("users")
}

// =====================================================
// CUSTOMERS
// =====================================================

model Customer {
  id            String   @id @default(uuid())
  companyName   String   @map("company_name")
  contactPerson String?  @map("contact_person")
  mobile        String?
  email         String?
  city          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  enquiries  Enquiry[]
  quotations Quotation[]
  orders     SalesOrder[]

  @@map("customers")
}

// =====================================================
// PRODUCTS
// =====================================================

model Product {
  id          String   @id @default(uuid())
  productCode String   @unique @map("product_code")
  name        String
  category    String
  unit        String // pcs, kg, m, box, etc.
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  gstPercent  Decimal  @default(18.00) @map("gst_percent") @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inventory      Inventory?
  enquiryItems   EnquiryItem[]
  quotationItems QuotationItem[]
  orderItems     SalesOrderItem[]
  dispatchItems  DispatchItem[]
  reservations   Reservation[]

  @@map("products")
}

// =====================================================
// INVENTORY (one row per product; UNIQUE on product_id)
// =====================================================

model Inventory {
  productId    String   @id @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])
  physicalQty  Int      @map("physical_qty")
  reservedQty  Int      @default(0) @map("reserved_qty")
  damagedQty   Int?     @map("damaged_qty") // nullable-for-later per spec
  reorderLevel Int?     @map("reorder_level")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("inventory")
}

// =====================================================
// ENQUIRIES
// =====================================================

model Enquiry {
  id            String        @id @default(uuid())
  enquiryNumber String        @unique @map("enquiry_number")
  customerId    String        @map("customer_id")
  customer      Customer      @relation(fields: [customerId], references: [id])
  enquiryDate   DateTime      @default(now()) @map("enquiry_date")
  requiredDate  DateTime?     @map("required_date")
  status        EnquiryStatus @default(OPEN)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items      EnquiryItem[]
  quotations Quotation[]

  @@index([customerId])
  @@index([status])
  @@map("enquiries")
}

model EnquiryItem {
  id        String  @id @default(uuid())
  enquiryId String  @map("enquiry_id")
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@index([enquiryId])
  @@index([productId])
  @@map("enquiry_items")
}

// =====================================================
// QUOTATIONS
// =====================================================

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique @map("quotation_number")
  enquiryId       String          @map("enquiry_id")
  enquiry         Enquiry         @relation(fields: [enquiryId], references: [id])
  customerId      String          @map("customer_id")
  customer        Customer        @relation(fields: [customerId], references: [id])
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?       @map("valid_until")
  grandTotal      Decimal         @default(0) @map("grand_total") @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  items QuotationItem[]
  order SalesOrder?

  @@index([enquiryId])
  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2)
  discountPct Decimal   @default(0) @map("discount_pct") @db.Decimal(5, 2)
  gstPct      Decimal   @default(18.00) @map("gst_pct") @db.Decimal(5, 2)
  lineAmount  Decimal   @map("line_amount") @db.Decimal(14, 2)

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

// =====================================================
// SALES ORDERS (quotation_id UNIQUE → DB-level "one quote → one order" guarantee)
// =====================================================

model SalesOrder {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number")
  customerId  String      @map("customer_id")
  customer    Customer    @relation(fields: [customerId], references: [id])
  quotationId String      @unique @map("quotation_id") // ← KEY CONSTRAINT
  quotation   Quotation   @relation(fields: [quotationId], references: [id])
  orderDate   DateTime    @default(now()) @map("order_date")
  totalAmount Decimal     @map("total_amount") @db.Decimal(14, 2)
  status      OrderStatus @default(CREATED)
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  items        SalesOrderItem[]
  dispatches   Dispatch[]
  reservations Reservation[]

  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model Reservation {
  id        String            @id @default(uuid())
  orderId   String?           @map("order_id")
  order     SalesOrder?       @relation(fields: [orderId], references: [id])
  productId String            @map("product_id")
  product   Product           @relation(fields: [productId], references: [id])
  quantity  Int
  status    ReservationStatus @default(PENDING)
  userId    String            @map("user_id")
  user      User              @relation(fields: [userId], references: [id])
  expiresAt DateTime?         @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId, status])
  @@map("reservations")
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String     @map("sales_order_id")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String     @map("product_id")
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    Decimal    @map("unit_price") @db.Decimal(12, 2)

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

// =====================================================
// DISPATCHES
// =====================================================

model Dispatch {
  id             String         @id @default(uuid())
  dispatchNumber String         @unique @map("dispatch_number")
  salesOrderId   String         @map("sales_order_id")
  salesOrder     SalesOrder     @relation(fields: [salesOrderId], references: [id])
  dispatchDate   DateTime       @default(now()) @map("dispatch_date")
  vehicleNumber  String?        @map("vehicle_number")
  driverName     String?        @map("driver_name")
  status         DispatchStatus @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  items DispatchItem[]

  @@index([salesOrderId])
  @@index([status])
  @@map("dispatches")
}

model DispatchItem {
  id         String   @id @default(uuid())
  dispatchId String   @map("dispatch_id")
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int

  @@index([dispatchId])
  @@index([productId])
  @@map("dispatch_items")
}
